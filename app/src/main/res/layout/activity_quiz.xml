<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/quizProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading quiz..."
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/quizQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Please wait."
            android:textColor="@color/text_primary"
            android:textSize="23sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/quizAnswerA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="60dp"
            android:padding="12dp"
            android:gravity="start|center_vertical"
            android:text="A"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <Button
            android:id="@+id/quizAnswerB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="60dp"
            android:padding="12dp"
            android:gravity="start|center_vertical"
            android:text="B"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <Button
            android:id="@+id/quizAnswerC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="60dp"
            android:padding="12dp"
            android:gravity="start|center_vertical"
            android:text="C"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <Button
            android:id="@+id/quizAnswerD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="60dp"
            android:padding="12dp"
            android:gravity="start|center_vertical"
            android:text="D"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/quizFeedbackText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityLiveRegion="polite"
            android:text="Choose one answer."
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/quizNextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="52dp"
            android:backgroundTint="@color/primary"
            android:enabled="false"
            android:text="Next Question"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/quizExitButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="Leave Quiz"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
