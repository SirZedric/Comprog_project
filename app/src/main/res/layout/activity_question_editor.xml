<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/questionEditorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add question"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@id/questionTextInput"
            android:text="Question"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/questionTextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="Enter the question"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="2000"
            android:minHeight="96dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/optionAInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Choice A"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="1000"
            android:minHeight="48dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/optionBInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Choice B"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="1000"
            android:minHeight="48dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/optionCInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Choice C"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="1000"
            android:minHeight="48dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/optionDInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Choice D"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="1000"
            android:minHeight="48dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@id/correctAnswerSpinner"
            android:text="Correct answer"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/correctAnswerSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Correct answer letter"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/saveQuestionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary"
            android:minHeight="48dp"
            android:text="Save question"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/cancelQuestionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Cancel" />
    </LinearLayout>
</ScrollView>
